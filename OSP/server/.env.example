# PostgreSQL connection string, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Secret used to sign JWT auth tokens
token_api=

# Google OAuth Client ID (Web application type), used to verify Google
# Sign-In ID tokens for student login. Create one at
# https://console.cloud.google.com/apis/credentials -- see Task 7 of
# docs/superpowers/plans/2026-09-07-google-oauth-student-login.md
GOOGLE_CLIENT_ID=

# Email account used to send OTP / password-reset emails (SMTP/nodemailer)
user=
pass=

# Port the server listens on (most hosts inject their own PORT and ignore this)
PORT=8080

# Origin of the deployed frontend, used for CORS. Falls back to http://localhost:3000
FRONTEND_URL=

# Set to "development" to include stack traces in error responses
NODE_ENV=development

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
